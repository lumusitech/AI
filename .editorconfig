root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: preserve intentional trailing whitespace (line breaks).
[*.md]
trim_trailing_whitespace = false

# Windows batch files need CRLF.
[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
