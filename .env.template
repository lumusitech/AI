# ==========================================
# Plantilla de Credenciales para Skills / IAs
# ==========================================

# Integraciones y Servicios Externos
GITHUB_TOKEN=tu_github_token_aqui
SUPABASE_ACCESS_TOKEN=tu_supabase_token_aqui
MERCADOPAGO_ACCESS_TOKEN=tu_mercadopago_token_aqui

# APIs de Modelos de Terceros (opcional / no utilizados por defecto)
# ANTHROPIC_API_KEY=tu_api_key_aqui
# OPENAI_API_KEY=tu_api_key_aqui

# Rutas / Endpoints MCP Locales
MCP_ANGULAR_DOCS_URL=http://localhost:3000/mcp/angular

# Navegador para el MCP playwright. Lo resuelve setup.sh / setup.ps1
# automáticamente (chrome si Chrome está instalado, si no chromium).
# No editarlo a mano: se sobrescribe en cada ejecución del setup.
# PLAYWRIGHT_BROWSER=chrome

# Memoria local per-usuario del MCP memory (la define setup.sh / memory-setup.sh).
# Nunca se commitea; ruta típica: ~/.local/share/opencode/memory/<github-user>.jsonl
# MEMORY_FILE_PATH=~/.local/share/opencode/memory/<user>.jsonl
