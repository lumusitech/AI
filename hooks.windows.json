{
  "PreToolUse": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "pwsh -NoProfile -File \"__REPO_DIR__\\hooks\\env-protection.ps1\""
        }
      ]
    }
  ],
  "Stop": [
    {
      "type": "command",
      "command": "pwsh -NoProfile -File \"__REPO_DIR__\\hooks\\notify.ps1\""
    }
  ]
}
