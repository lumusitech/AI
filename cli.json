{
  "$schema": "https://opencode.ai/v2/cli.json",
  "scroll": {
    "acceleration": true
  },
  "theme": {
    "name": "tokyonight"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  }
}
