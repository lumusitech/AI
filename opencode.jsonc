{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.agent/AGENTS.md"
  ],
  "lsp": true,
  "plugin": [
    "@tarquinen/opencode-dcp",
    "@cortexkit/opencode-magic-context"
  ],
  "skills": {
    "paths": [
      "~/.agent/skills"
    ]
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@astudioplus/codegraph-mcp"
      ]
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "~/.agent/memory.jsonl"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ]
    }
  }
}
