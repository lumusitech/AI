{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.agent/AGENTS.md"
  ],
  "model": "openrouter/deepseek/deepseek-v4.1-flash",
  "provider": {
    "openrouter": {
      "order": [
        "sail-research"
      ],
      "allow_fallbacks": true
    }
  },
  "lsp": true,
  "compaction": {
    "auto": false
  },
  "plugin": [
    "@tarquinen/opencode-dcp@3.2.0"
  ],
  "skills": {
    "paths": [
      "~/.agent/skills"
    ]
  },
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ]
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph-mcp"
      ]
    },
    "context7": {
      "type": "local",
      "command": [
        "context7-mcp"
      ]
    },
    "github": {
      "type": "local",
      "command": [
        "github-mcp-bridge"
      ]
    },
    "memory": {
      "type": "local",
      "command": [
        "mcp-server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "{env:MEMORY_FILE_PATH}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "playwright-mcp"
      ],
      "environment": {
        "PLAYWRIGHT_MCP_BROWSER": "{env:PLAYWRIGHT_BROWSER}"
      }
    }
  }
}