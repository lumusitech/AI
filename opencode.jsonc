{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.agent/AGENTS.md"
  ],
  "lsp": true,
  "permission": {
    "read": "allow",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "which *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "ps *": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "desktop-file-validate *": "allow"
    }
  },
  "compaction": {
    "auto": false
  },
  "plugin": [
    "@tarquinen/opencode-dcp@3.1.15"
  ],
  "skills": {
    "paths": [
      "~/.agent/skills"
    ]
  },
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ]
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph-mcp"
      ]
    },
    "context7": {
      "type": "local",
      "command": [
        "context7-mcp"
      ]
    },
    "github": {
      "type": "local",
      "command": [
        "mcp-server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "memory": {
      "type": "local",
      "command": [
        "mcp-server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "{env:MEMORY_FILE_PATH}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "playwright-mcp"
      ],
      "environment": {
        "PLAYWRIGHT_MCP_BROWSER": "{env:PLAYWRIGHT_BROWSER}"
      }
    }
  }
}
